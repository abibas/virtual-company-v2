# syntax=docker/dockerfile:1
#
# The runner in a container (docs/machines.md, "Installing a runner"): Node 24, git, Claude Code and Codex (pinned, for
# chat turns), the GitHub CLI (pinned and checksum-checked, for an agent's habitual `gh pr …` in a turn whose profile may
# push: S7.1d, docs/harness.md "git in a turn") and tini as PID 1, with the runner bundle (apps/runner/dist/runner.mjs, built here; reproducible, so it is
# the same bytes the server serves from the same commit), its manifest runner.json (its build time) and the terminal's PTY
# for the image's system beside it (node_modules/@lydell/node-pty-linux-<arch>, unpacked from the build's dist/pty/),
# run by a non-root user. Its
# state, runner.json with the runner key included, is the volume /var/lib/mwc-runner. On its first start, without a
# runner.json and with MWC_ENROLL_TOKEN and MWC_SERVER_URL, the runner enrolls the container (kind container), then
# runs; later starts need no token. Its terminal's shell is /bin/bash as the user runner, in /home/runner. Its agents'
# home folders live in the volume /work, owned by runner: the only folders its folder browser reads and makes (a named
# volume copies this ownership when it is first mounted), so they survive restarts and image rebuilds. The CLIs the
# card's Install / Update puts there (npm, `--prefix ~/.local`) live in the volume /home/runner/.local, first on the
# PATH, so an updated Claude Code or Codex comes before the image's own and outlasts rebuilds too. Claude Code's own
# store (its conversations, which a chat resumes, and its .claude.json) is the volume /home/runner/.claude, named by
# CLAUDE_CONFIG_DIR (so .claude.json lives inside it too), and Codex's home for a person's own `codex` in the terminal is
# the volume /home/runner/.codex (CODEX_HOME; a turn's Codex runs in the runner's own folder under the state volume),
# so a rebuild keeps both (docs/machines.md, "The Docker runner's volumes").
#
#   docker build -f deploy/Dockerfile.runner -t mwc-v2/runner:local .
#   MWC_ENROLL_TOKEN=mwc_et_... MWC_RUNNER_NAME='Docker runner' MWC_RUNNER_CPUS=2 MWC_RUNNER_MEMORY=4g MWC_RUNNER_SLOTS=2 \
#     docker compose -p mwc-runner-docker-runner -f deploy/compose.yml --profile runner up -d runner-local

ARG NODE_IMAGE=node:24.21.0-slim

# pnpm at the version pinned in package.json ("packageManager"), through corepack.
FROM ${NODE_IMAGE} AS pnpm
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true
WORKDIR /app
COPY package.json ./
RUN corepack enable && corepack install

# The runner as one file: the runner, the workspace packages it depends on, and its build tool (esbuild); and the
# terminal's PTY of this image's system (the stage runs on the same system as the runtime), unpacked into /out.
FROM pnpm AS bundle
COPY . .
RUN --mount=type=cache,id=mwc-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store --filter-prod "@mwc/runner..." \
 && pnpm --filter @mwc/runner build \
 && mkdir -p /out \
 && tar -xzf "apps/runner/dist/pty/linux-$(node -p process.arch).tgz" -C /out

FROM ${NODE_IMAGE} AS runtime
# The harnesses a container runs chat turns with (docs/harness.md): the official Claude Code and Codex CLIs at the exact
# versions deploy/Dockerfile.login pins (claude-code 2.1.308, codex 0.163.0), so the runner's hello reports both.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git tini \
 && rm -rf /var/lib/apt/lists/* \
 && npm install --global --no-fund --no-audit --no-update-notifier \
      @anthropic-ai/claude-code@2.1.308 @openai/codex@0.163.0 \
 && npm cache clean --force \
 && command -v claude codex \
 && useradd --create-home --uid 10001 --user-group runner \
 && mkdir -p /home/runner/.local/bin /home/runner/.claude /home/runner/.codex \
 && chown -R runner:runner /home/runner/.local /home/runner/.claude /home/runner/.codex \
 && chmod 0700 /home/runner/.claude /home/runner/.codex \
 && mkdir -p /opt/mwc-runner /var/lib/mwc-runner /work \
 && chown runner:runner /var/lib/mwc-runner /work \
 && chmod 0700 /var/lib/mwc-runner \
 && chmod 0755 /work
# The GitHub CLI, as deploy/Dockerfile.login pins it: gh 2.103.3 (published 2026-10-26, pinned 2026-11-12), the release
# for this machine's architecture, downloaded with Node (the slim image has no curl), checked against the SHA-256 GitHub
# published for it, unpacked to /usr/local/bin. A turn gives it the profile's sign-in as GH_TOKEN; it never signs in.
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) sum=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d ;; \
      arm64) sum=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63 ;; \
      *) echo "no GitHub CLI release for $arch" >&2; exit 1 ;; \
    esac \
 && node -e 'fetch(process.argv[1]).then(async (r) => { if (!r.ok) throw new Error(`HTTP ${r.status}`); require("node:fs").writeFileSync("/tmp/gh.tar.gz", Buffer.from(await r.arrayBuffer())); })' \
      "https://github.com/cli/cli/releases/download/v2.103.3/gh_2.103.3_linux_${arch}.tar.gz" \
 && echo "$sum  /tmp/gh.tar.gz" | sha256sum --check --strict \
 && tar -xzf /tmp/gh.tar.gz --strip-components=2 -C /usr/local/bin "gh_2.103.3_linux_${arch}/bin/gh" \
 && rm /tmp/gh.tar.gz \
 && gh --version
# The container is the machine (kind container); its configuration lives in the state volume; nothing holds it awake.
ENV NODE_ENV=production \
    PATH=/home/runner/.local/bin:$PATH \
    DISABLE_AUTOUPDATER=1 \
    NO_UPDATE_NOTIFIER=1 \
    MWC_RUNNER_IN_CONTAINER=1 \
    MWC_RUNNER_STATE_DIR=/var/lib/mwc-runner \
    MWC_RUNNER_CONFIG=/var/lib/mwc-runner/runner.json \
    MWC_RUNNER_HOLD=none \
    GH_PROMPT_DISABLED=1 \
    GH_NO_UPDATE_NOTIFIER=1 \
    GH_TELEMETRY=false \
    GH_SPINNER_DISABLED=1 \
    CLAUDE_CONFIG_DIR=/home/runner/.claude \
    CODEX_HOME=/home/runner/.codex
COPY --from=bundle /app/apps/runner/dist/runner.mjs /opt/mwc-runner/runner.mjs
COPY --from=bundle /app/apps/runner/dist/runner.json /opt/mwc-runner/runner.json
COPY --from=bundle /out/node_modules /opt/mwc-runner/node_modules
USER runner
WORKDIR /home/runner
VOLUME /var/lib/mwc-runner /work /home/runner/.local /home/runner/.claude /home/runner/.codex
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:9953/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
# tini forwards SIGTERM to the runner (which stops its runs and releases its hold) and reaps what it leaves.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "/opt/mwc-runner/runner.mjs", "run"]
