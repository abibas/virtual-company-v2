# The variables the server reads from its environment (@mwc/shared/config). In development, `pnpm dev`
# (mwc dev), `pnpm dev:server` and `pnpm dev:memory` start the API with .env, then .env.local, from the repository
# root (node --env-file-if-exists): .env.local wins over .env, and variables set in the shell win over both. Elsewhere
# (the server image, compose) the environment is the only source. `pnpm dev` sets DATABASE_URL to the dev compose
# Postgres and NODE_ENV to development when the shell has none. Never commit .env or .env.local.
# Postgres from deploy/compose.yml. Dev ports: see docs/ports.md.
DATABASE_URL=postgres://mwc:mwc@localhost:9952/mwc
MWC_PORT=9950
# Worktree slot 0..9 instead of MWC_PORT: the API takes 9960+3k (docs/ports.md).
# MWC_PORT_SLOT=0
# The address other machines reach the API at. GET /api/config answers it as publicUrl (null while unset). The
# Airia devbox needs none: it reaches the API through This Mac's SSH tunnel on the port of this address
# (docs/machines.md, "Installing a runner"), so keep it the API's own address in development.
MWC_PUBLIC_URL=http://localhost:9950
MWC_LOG_LEVEL=info
# The built web UI the server serves for / (the container image sets /app/apps/web/dist).
# MWC_WEB_DIST=apps/web/dist
# Bind address of the API: loopback by default; the compose image sets 0.0.0.0.
# MWC_HOST=127.0.0.1
# Apply pending migrations when the server starts (compose runs a one-shot migrate step instead).
# MWC_MIGRATE_ON_START=false

# Sign-in: clerk or none. Defaults to clerk when CLERK_SECRET_KEY is set, else none (health and the UI only;
# routes that need a signed-in caller answer 503 identity_not_configured).
# MWC_IDENTITY=
# The web origin whose session tokens the API accepts (Clerk's azp). Defaults to http://localhost:9951 (the
# slot's web port with MWC_PORT_SLOT) and, in production, to the origin of MWC_PUBLIC_URL.
# MWC_WEB_ORIGIN=http://localhost:9951

# The jobs loop (the identity outbox, the retry of webhook events, the periodic reconcile): on by default, off with
# NODE_ENV=test. One process per database runs it (a Postgres advisory lock); the others wait for the lock.
# MWC_JOBS=on
# Minutes between two reconciles of one company with its organization (1 to 1440), each company in its own slot.
# MWC_RECONCILE_MINUTES=10

# Who may create companies: any (everyone signed in), allowlist (only MWC_COMPANY_CREATORS) or none. Defaults to
# any, and to allowlist in production (where, without MWC_COMPANY_CREATORS, nobody may).
# MWC_COMPANY_CREATION=
# The emails MWC_COMPANY_CREATION=allowlist lets create companies, comma-separated (compared lower-cased).
# MWC_COMPANY_CREATORS=

# The master key that seals people's subscriptions (AES-256-GCM): the base64 of 32 random bytes
# (openssl rand -base64 32). Required in production, where the server refuses to start without it. In development,
# without it, the server makes .data/master.key once (0600, git-ignored) and reads it on every later start. Keep it:
# subscriptions sealed under one key do not open under another. Put a value in .env or .env.local, never here.
MWC_MASTER_KEY=

# Where Sign in with Claude and Sign in with OpenAI run the official CLIs' logins (docs/subscriptions.md): docker (a
# throwaway container of deploy/Dockerfile.login, built on the first sign-in; the development default), local (a
# private temporary folder on a Linux server that has the CLIs and util-linux's script) or none (those sign-ins answer
# 503; the default in production and tests).
# MWC_LOGIN_HELPER=

# Clerk (connectors/identity-clerk; docs/clerk-setup.md): the development instance's keys, from the Clerk
# dashboard (Configure → API keys). Put the values in .env or .env.local (local wins), never here. The
# server wires the connector when they are set; `pnpm --filter @mwc/identity-clerk contract` loads both files.
# Backend API secret key: sk_test_... (development instance).
CLERK_SECRET_KEY=
# Publishable key: pk_test_...; it encodes the Frontend API host, which is the issuer of session tokens.
CLERK_PUBLISHABLE_KEY=
# Optional: the instance's JWT public key (PEM; escaped \n newlines are fine) for networkless token
# verification. Empty: tokens are verified with the JWKS, fetched with the secret key and cached.
CLERK_JWT_KEY=
# Optional: the signing secret (whsec_...) of the Clerk webhook endpoint that points at
# POST /api/webhooks/clerk (docs/clerk-setup.md, "Webhooks"). Empty: that route answers 503
# webhooks_not_configured, and reconcile keeps memberships current instead.
CLERK_WEBHOOK_SIGNING_SECRET=

# Seconds a running chat turn whose runner went away (its link dropped, or the API restarted) waits for that runner to
# come back with it before it fails (docs/harness.md, "Surviving restarts"): 1 to 3600, default 180.
# MWC_TURN_GRACE_SECONDS=180

# Whether the API starts and stops the Airia devboxes itself with this computer's airia CLI and gcloud, and
# holds their SSH tunnels (docs/machines.md): auto (the default: when both are found, outside production), on (the
# start fails without them) or off (a runner controller on a Mac does it).
# MWC_LOCAL_POWER=auto

# Whether the API rebuilds a Docker container runner itself when someone clicks Update container (docs/machines.md,
# "Updating a runner"): auto (the default: when the docker CLI is found and NODE_ENV is development), on (the start
# fails without it) or off (the card shows the docker compose command to run instead).
# MWC_LOCAL_DOCKER=auto

# Dictation in the chat composer (docs/speech.md): whisper.cpp transcribes each clip on this server's own computer (no
# cloud service, no credential). auto (the default: when whisper-server or whisper-cli and a model are found, outside
# production and tests) or off (the composer hides its microphone).
# MWC_WHISPER=auto
# The model, a ggml-*.bin file (~/ is the home folder). Unset: the first of the known places that has
# ggml-large-v3-turbo-q5_0.bin (docs/speech.md).
# MWC_WHISPER_MODEL=
# The language spoken (en, uk, ...), or auto to detect it per clip.
# MWC_WHISPER_LANGUAGE=auto
# Optional: words Whisper should spell your way (names, products), sent as its prompt.
# MWC_WHISPER_PROMPT=
# The warm whisper-server's port, on 127.0.0.1 only (docs/ports.md).
# MWC_WHISPER_PORT=9957

# Notification emails (docs/notifications.md): outbox (the development default: each email an .eml file in
# .data/outbox/, read with `pnpm mwc dev outbox`; nothing is sent), off (the default elsewhere, tests included: none go
# out), or smtp (not built yet: the server refuses to start with it).
# MWC_EMAIL=outbox
# The From of notification emails.
# MWC_EMAIL_FROM=Most Wanted Corp <no-reply@localhost>
# For MWC_EMAIL=smtp once it is built: smtp:// or smtps://user:password@host:port. A secret: put it in .env or
# .env.local, never here.
# MWC_SMTP_URL=
