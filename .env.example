# The variables the server reads from its environment (@mwc/shared/config). Nothing loads a .env file
# automatically: export them, or start the server with `node --env-file=.env apps/server/src/main.ts`.
# `pnpm dev` (mwc dev) sets DATABASE_URL to the dev compose Postgres when it is unset. Never commit .env.
# Postgres from deploy/compose.yml. Dev ports: see docs/ports.md.
DATABASE_URL=postgres://mwc:mwc@localhost:9952/mwc
MWC_PORT=9950
# Worktree slot 0..9 instead of MWC_PORT: the API takes 9960+3k (docs/ports.md).
# MWC_PORT_SLOT=0
MWC_PUBLIC_URL=http://localhost:9950
MWC_LOG_LEVEL=info
# The built web UI the server serves for / (the container image sets /app/apps/web/dist).
# MWC_WEB_DIST=apps/web/dist
# Bind address of the API: loopback by default; the compose image sets 0.0.0.0.
# MWC_HOST=127.0.0.1
# Apply pending migrations when the server starts (compose runs a one-shot migrate step instead).
# MWC_MIGRATE_ON_START=false
