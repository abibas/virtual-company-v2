{
  "name": "@mwc/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, SQL migrations, the tenant layer and database handles (postgres.js, PGlite) for Most Wanted Corp v2.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./system": "./src/system.ts",
    "./pglite": "./src/pglite.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node scripts/migrate.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "diagram": "node scripts/schema-diagram.ts --write",
    "check:diagram": "node scripts/schema-diagram.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@mwc/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "drizzle-kit": "0.31.11"
  }
}
