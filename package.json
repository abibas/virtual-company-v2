{
  "name": "most-wanted-corp-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Most Wanted Corp v2: humans and AI agents in one organization, rebuilt from scratch.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "test -e .git && git config core.hooksPath .githooks || true",
    "mwc": "node packages/cli/src/mwc.ts",
    "dev": "node packages/cli/src/mwc.ts dev",
    "check": "node packages/cli/src/mwc.ts check",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @mwc/web dev",
    "e2e": "pnpm --filter @mwc/web e2e",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
