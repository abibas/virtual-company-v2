  },
  "scripts": {
    "start": "node src/main.ts run",
    "test": "vitest run"
  },
  "dependencies": {
    "@mwc/shared": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mwc/testkit": "workspace:*",
    "@types/ws": "8.18.2"
  }
}
