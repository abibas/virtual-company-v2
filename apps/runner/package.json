{
  "name": "@mwc/runner",
  "version": "0.1.0",
  "private": true,
  "description": "The runner daemon, installed once on every machine: it dials out to the server, sends heartbeats with the machine's stats, and keeps the machine awake while it is held. Built into one file (dist/runner.mjs) that also enrolls the machine and installs its service.",
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./power": "./src/power.ts",
    "./runner": "./src/runner.ts",
    "./start": "./src/start.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node src/main.ts run",
    "test": "vitest run"
  },
  "dependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.15",
    "@mwc/machine-airia-devbox": "workspace:*",
    "@mwc/machines-core": "workspace:*",
    "@mwc/shared": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mwc/testkit": "workspace:*",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2"
  }
}
